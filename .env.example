# ==============================================================================
# TechSAR System Environment Configuration (.env)
# ระบบงานประกันคุณภาพการศึกษาและรายงานการประเมินตนเอง (Self-Assessment Report)
# ==============================================================================
# คำแนะนำ: คัดลอกไฟล์นี้ไปเป็น .env ในโฟลเดอร์ services/qa-web/
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# รูปแบบ: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]?schema=public
# - กรณีต่อผ่าน Tailscale VPN (Proxmox Server): ใช้ IP 100.125.250.85
# - กรณีต่อผ่าน Local LAN เดียวกับเซิร์ฟเวอร์: ใช้ IP 192.168.1.250 หรือ 10.10.10.102
# - กรณีรัน PostgreSQL บนเครื่องตัวเอง (Local Docker): ใช้ localhost หรือ 127.0.0.1
DATABASE_URL="postgresql://qa_admin:SuperSecretPassword123@100.125.250.85:5432/qa_system_db?schema=public"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH.JS AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# NEXTAUTH_URL: Base URL ของเว็บแอปพลิเคชัน
# - เครื่องพัฒนา (Localhost): http://localhost:3000
# - เครื่อง Production / เซิร์ฟเวอร์จริง: https://your-domain.com หรือ http://100.125.250.85:3000
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET: คีย์เข้ารหัสสำหรับ JWT Token และ Session Cookie (ความยาวอย่างน้อย 32 ตัวอักษร)
# - วิธีสร้างคีย์สุ่ม: เปิด terminal แล้วรัน `openssl rand -base64 32`
NEXTAUTH_SECRET="techsar-dev-super-secret-key-32-chars-minimum-length"

# ------------------------------------------------------------------------------
# 3. ROOT ADMIN FALLBACK CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# อีเมลและรหัสผ่านเริ่มต้นสำหรับบัญชี Super Admin สูงสุด (ใช้สำหรับ Seed หรือ Fallback)
ROOT_ADMIN_EMAIL="admin@technic.ac.th"
ROOT_ADMIN_PASSWORD="admin1234"

# ------------------------------------------------------------------------------
# 4. MINIO S3 OBJECT STORAGE CONFIGURATION (ระบบจัดเก็บไฟล์รูปและ Snapshot)
# ------------------------------------------------------------------------------
# S3_ENDPOINT: URL ของ MinIO S3 API Server (Port 9000)
# - ต่อผ่าน Tailscale: http://100.125.250.85:9000
# - ต่อในเครื่องเซิร์ฟเวอร์เดียวกัน (Internal Network): http://10.10.10.102:9000
# - รัน Localhost: http://localhost:9000
S3_ENDPOINT="http://100.125.250.85:9000"

# S3_ACCESS_KEY: Access Key (หรือ Username ของ MinIO)
S3_ACCESS_KEY="minioadmin"

# S3_SECRET_KEY: Secret Key (หรือ Password ของ MinIO)
S3_SECRET_KEY="miniopassword123"

# S3_BUCKET_NAME: ชื่อ Bucket สำหรับเก็บไฟล์หลักฐาน, รูปโปรไฟล์ และ Snapshot
# (ระบบจะใช้ Bucket ชื่อนี้เป็นหลัก ตรวจสอบว่าใน MinIO ได้สร้าง Bucket นี้ไว้แล้ว)
S3_BUCKET_NAME="qa-evidences"

# ------------------------------------------------------------------------------
# 5. NODE ENVIRONMENT
# ------------------------------------------------------------------------------
# development = โหมดพัฒนา (แสดง Error logs ละเอียด)
# production  = โหมดใช้งานจริง (Optimized build)
NODE_ENV="development"
