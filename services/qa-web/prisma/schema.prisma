// Prisma Schema for TechSAR - Educational Quality Assurance System
// Database: PostgreSQL 16 (Proxmox CT 102)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudentStatus {
  ACTIVE         // กำลังศึกษา
  GRADUATED      // สำเร็จการศึกษา
  SUSPENDED      // พักการเรียน
  DROPPED        // พ้นสภาพ
}

enum LicenseStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  IN_RENEWAL
}

model LicenseCategoryConfig {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "ksp", "vocational", "other", "custom_..."
  title       String   // e.g. "ใบอนุญาตคุรุสภา / ผ่อนผัน (KSP)"
  description String?  // e.g. "มาตรฐานวิชาชีพครูสำหรับสถานศึกษา"
  icon        String   @default("GraduationCap") // "GraduationCap" | "Award" | "Shield" | "FileBadge" | "Briefcase" | "Sparkles"
  color       String   @default("teal") // "teal" | "emerald" | "blue" | "purple" | "amber" | "indigo" | "rose" | "slate"
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model LicenseTypeConfig {
  id                      String   @id @default(cuid())
  code                    String   @unique // e.g. "KSP_B_LICENSE", "TPQI_CERTIFICATE", "CUSTOM_..."
  title                   String   // e.g. "ใบอนุญาตประกอบวิชาชีพครูชั้นต้น (B-License)"
  description             String?  // e.g. "ใบอนุญาตประกอบวิชาชีพครูชั้นต้น (อายุ 5 ปี)"
  category                String   @default("ksp") // "ksp" | "vocational" | "other"
  categoryLabel           String?  // e.g. "ใบอนุญาตคุรุสภา / ผ่อนผัน (KSP)"
  defaultYears            Int      @default(5)     // อายุการใช้งานเริ่มต้น (ปี)
  issuer                  String?  // e.g. "สำนักงานเลขาธิการคุรุสภา", "สถาบันคุณวุฒิวิชาชีพ"
  color                   String   @default("teal") // "teal" | "purple" | "blue" | "amber" | "emerald" | "indigo" | "rose" | "slate"
  icon                    String   @default("GraduationCap") // "GraduationCap" | "Award" | "Shield" | "Clock" | "FileBadge" | "Briefcase" | "Sparkles"
  requiresProvisionalRound Boolean  @default(false) // true กรณีเป็นหนังสือผ่อนผัน (รอบ 1, 2, 3)
  requiresTitle           Boolean  @default(false) // true กรณีต้องระบุสาขา/ระดับ
  titleLabel              String?  // e.g. "ระบุสาขาวิชาชีพ / ระดับมาตรฐาน / สาขาวิศวกรรม"
  titlePlaceholder        String?  // e.g. "เช่น สาขาเทคโนโลยีสารสนเทศและการสื่อสาร ระดับ 4"
  presetChips             String[] @default([])    // รายการตัวเลือกแนะนำที่คลิกเพื่อใส่ข้อความ
  sortOrder               Int      @default(0)
  isActive                Boolean  @default(true)
  isSystem                Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([category])
  @@index([sortOrder])
}

model RoleDefinition {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "ROOT", "STAFF", "DEPT_HEAD", "TEACHER"
  title       String   // e.g. "ผู้ดูแลระบบสูงสุด (ROOT)", "บุคลากรทั่วไป (STAFF)"
  description String?
  color       String   @default("blue") // "rose" | "blue" | "emerald" | "purple" | "amber"
  permissions String[] // Allowed paths e.g. ["/dashboard", "/admin/users", "/profile"]
  isSystem    Boolean  @default(false) // true for ROOT (cannot be deleted)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "USER_LOGIN", "UPDATE_PROFILE", "UPDATE_EDUCATION", "UPDATE_EXPERIENCE", "UPDATE_SKILLS", "UPDATE_TEACHER_LICENSE", "UPLOAD_EVIDENCE", "CREATE_USER"
  title     String   // ข้อความกิจกรรม เช่น "อัปเดตข้อมูลส่วนตัว", "เพิ่มประวัติการศึกษา"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model TeacherLicense {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  licenseType       String        @default("KSP_B_LICENSE") // code from LicenseTypeConfig or enum string
  licenseNumber     String        // เลขที่ใบอนุญาต หรือ เลขที่หนังสือรับรอง
  title             String?       // ระบุสาขา/ระดับ (เช่น "สาขาวิศวกรรมคอมพิวเตอร์", "ระดับ 2", "สาขาเทคโนโลยีสารสนเทศ ระดับ 4")
  provisionalRound  Int?          // ครั้งที่ได้รับการผ่อนผัน (เฉพาะกรณีหนังสือผ่อนผัน: 1, 2, 3)
  
  nameTh            String?       // ชื่อ-นามสกุลภาษาไทยตามหน้าบัตร
  nameEn            String?       // ชื่อ-นามสกุลภาษาอังกฤษตามหน้าบัตร
  issuedDate        DateTime      // วันที่ออกบัตร / วันที่ได้รับหนังสือรับรอง
  expiredDate       DateTime      // วันที่หมดอายุ
  status            LicenseStatus @default(ACTIVE)

  // ไฟล์แนบหลักฐาน (สแกนบัตร / PDF จากคุรุสภา KSP Self-Service / TPQI / DSD)
  attachmentKey     String?       // S3/MinIO Key หรือ Application URL ของไฟล์เอกสาร
  attachmentName    String?       // ชื่อไฟล์เดิม

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([licenseType])
  @@index([expiredDate])
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String?
  name             String
  roleCode         String           @default("STAFF") // code reference
  roleDefinitionId String?
  roleDefinition   RoleDefinition?  @relation(fields: [roleDefinitionId], references: [id])
  position         String?          // ตำแหน่ง เช่น ครูผู้ช่วย, ครูชำนาญการ, เจ้าหน้าที่ธุรการ
  phone            String?          // เบอร์โทรศัพท์
  birthDate        DateTime?        // วันเดือนปีเกิด
  avatarUrl        String?          // URL รูปประจำตัว
  coverUrl         String?          // ภาพหน้าปกโปรไฟล์ (Cover photo)
  bio              String?          // คำแนะนำตัว / ปรัชญาการศึกษา
  education        Json?            // วุฒิการศึกษา [{ degree, major, institution, year }]
  workHistory      Json?            // ประวัติการทำงาน [{ role, organization, period }]
  licenses         Json?            // ใบอนุญาตประกอบวิชาชีพทั่วไป / อื่นๆ
  teacherLicenses  TeacherLicense[] // ข้อมูลใบอนุญาตประกอบวิชาชีพทางการศึกษาและคุณวุฒิวิชาชีพ (คุรุสภา / TPQI / DSD / กว.)
  skills           String[]         // ทักษะ / ความเชี่ยวชาญ
  isActive         Boolean          @default(true)
  evidenceFiles    EvidenceFile[]   // ไฟล์หลักฐานและร่องรอยผลงาน (แผนการสอน, วุฒิบัตร, ภาพอบรม, วิจัย, ชิ้นงานเด็ก ฯลฯ)
  activities       ActivityLog[]
  advisedStudents  Student[]     // นักเรียนที่อยู่ในความดูแล (ครูที่ปรึกษา)
  teachingAssignments TeachingAssignment[] // รายวิชาที่ได้รับมอบหมายให้สอน
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([email])
}

model EvidenceFile {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title         String   // ชื่อเอกสาร / หัวข้อหลักฐาน (เช่น "แผนการจัดการเรียนรู้วิชาเครือข่าย")
  description   String?  // รายละเอียดเพิ่มเติม (เช่น "สถานที่อบรม, หัวข้อบรรยาย")
  category      String   // "lesson_plan" | "training_cert" | "training_photo" | "speaker_activity" | "research" | "license" | "student_work" | "other"
  
  fileKey       String   // S3 MinIO Object Key
  fileUrl       String   // URL สำหรับเข้าถึงไฟล์
  fileName      String   // ชื่อไฟล์ต้นฉบับ
  fileType      String   // MIME Type เช่น "application/pdf", "image/jpeg"
  fileSize      Int      // ขนาดไฟล์ (Bytes)
  
  academicYear  String   @default("2568") // ปีการศึกษา เช่น "2568"
  semester      String   @default("1")    // ภาคเรียน เช่น "1", "2", "all"
  
  metadata      Json?    // { location, organization, eventDate, subjectCode, gradeLevel, externalVideoUrl }
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([academicYear, semester])
  @@index([createdAt])
}

// ทะเบียนข้อมูลนักเรียนนักศึกษา (ดัดแปลงจาก activity_attendance_System)
model Student {
  id            String        @id @default(cuid())
  studentCode   String        // รหัสนักศึกษา 11 หลัก (e.g. "66209010001")
  prefix        String        // คำนำหน้า: "นาย", "นางสาว"
  firstName     String        // ชื่อจริง
  lastName      String        // นามสกุล

  level         String        // ระดับชั้น: "ปวช", "ปวส"
  year          String        // ชั้นปี: "1", "2", "3"
  majorName     String        // ชื่อเต็มสาขาวิชา (e.g. "เทคนิคคอมพิวเตอร์")
  majorCode     String        // ชื่อย่อสาขาวิชา (e.g. "ชทค", "สทค")
  room          String        // กลุ่มเรียน / ห้อง ("1", "2")

  status        StudentStatus @default(ACTIVE)
  academicYear  String        // ปีการศึกษา พ.ศ. (e.g. "2568")
  semester      String        @default("1") // ภาคเรียน ("1", "2")

  advisorId     String?       // FK → User (ครูที่ปรึกษา) optional
  advisor       User?         @relation(fields: [advisorId], references: [id])
  attendanceRecords AttendanceRecord[] // ประวัติการเข้าเรียน

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([studentCode, academicYear, semester])
  @@index([academicYear, semester])
  @@index([level, year, majorCode])
  @@index([advisorId])
  @@index([status])
}

// การตั้งค่ารอบปีการศึกษาและภาคเรียน (Academic Years & Terms)
model AcademicYearConfig {
  id          String    @id @default(cuid())
  year        String    // ปีการศึกษา พ.ศ. เช่น "2568"
  semester    String    // ภาคเรียน เช่น "1", "2", "all"
  label       String    // เช่น "ภาคเรียนที่ 1"
  isCurrent   Boolean   @default(false) // ปี/เทอมหลักของสถานศึกษา
  isActive    Boolean   @default(true)  // เปิดใช้งานให้เลือกหรือไม่
  startDate   DateTime? // วันเปิดภาคเรียน
  endDate     DateTime? // วันปิดภาคเรียน
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([year, semester])
  @@index([isCurrent])
  @@index([isActive])
}

// การตั้งค่าระดับชั้น สาขาวิชา และกลุ่มเรียน (Curriculum & Class Sections Master Data)
model ClassSectionConfig {
  id          String   @id @default(cuid())
  level       String   // ระดับชั้น: "ปวช", "ปวส"
  year        String   // ชั้นปี: "1", "2", "3"
  majorName   String   // ชื่อเต็มสาขาวิชา เช่น "ช่างเทคนิคคอมพิวเตอร์"
  majorCode   String   // ชื่อย่อสาขาวิชา เช่น "ชทค"
  room        String   // กลุ่มเรียน / ห้อง เช่น "1", "2"
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([level, year, majorCode, room])
  @@index([level, year])
  @@index([isActive])
}

// ข้อมูลรายวิชา (Courses / Subjects)
model Course {
  id           String               @id @default(cuid())
  courseCode   String               @unique // รหัสวิชา เช่น "20204-2001"
  courseName   String               // ชื่อวิชา เช่น "การเขียนโปรแกรมคอมพิวเตอร์"
  theoryHours  Int                  @default(2) // ทฤษฎี (ชม./สัปดาห์)
  practiceHours Int                 @default(2) // ปฏิบัติ (ชม./สัปดาห์)
  credits      Int                  @default(3) // หน่วยกิต
  level        String               @default("ปวช") // "ปวช", "ปวส"
  majorCode    String               @default("ชทค") // รหัสย่อสาขาวิชา เช่น "ชทค"
  isActive     Boolean              @default(true)
  assignments  TeachingAssignment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([majorCode])
  @@index([level])
}

// การมอบหมายการสอนรายวิชาและห้องเรียน (Teaching Assignments)
model TeachingAssignment {
  id           String              @id @default(cuid())
  courseId     String
  course       Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      User                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear String              // ปีการศึกษา เช่น "2568"
  semester     String              @default("1") // ภาคเรียน "1", "2"
  level        String              // "ปวช", "ปวส"
  year         String              // "1", "2", "3"
  majorCode    String              // "ชทค"
  room         String              // "1", "2"
  totalPeriods Int                 @default(72) // คาบเรียนตลอดเทอม (18 สัปดาห์ x 4 คาบ)
  sessions     AttendanceSession[]
  records      AttendanceRecord[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([courseId, teacherId, academicYear, semester, level, year, majorCode, room])
  @@index([teacherId])
  @@index([academicYear, semester])
  @@index([level, year, majorCode, room])
}

// รอบการเช็กชื่อรายวัน / รายคาบ (Daily Attendance Session)
model AttendanceSession {
  id           String              @id @default(cuid())
  assignmentId String
  assignment   TeachingAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  date         DateTime            // วันที่เช็คชื่อ
  period       String?             // คาบเรียน เช่น "1-2", "3-4"
  week         Int                 @default(1) // สัปดาห์ที่ 1 - 18
  note         String?             // หัวข้อการสอน / หมายเหตุ
  createdBy    String?             // ผู้บันทึก (ครู)
  records      AttendanceRecord[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([assignmentId])
  @@index([date])
  @@index([week])
}

// รายการบันทึกสถานะการมาเรียนรายคน (Attendance Record)
model AttendanceRecord {
  id           String              @id @default(cuid())
  assignmentId String
  assignment   TeachingAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sessionId    String?             // อ้างอิงรอบเช็กชื่อ (ถ้ามี)
  session      AttendanceSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentCode  String              // รหัสนักศึกษา 11 หลัก
  status       String              // "PRESENT" (มา), "LATE" (สาย), "ABSENT" (ขาด), "LEAVE" (ลา)
  remark       String?             // หมายเหตุพฤติกรรม
  date         DateTime            @default(now())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([assignmentId])
  @@index([studentId])
  @@index([studentCode])
  @@index([status])
  @@index([date])
}

// ข้อมูลบริบทแผนกวิชา (Department Profile & Context สำหรับเอกสาร SAR)
model DepartmentProfile {
  id              String   @id @default(cuid())
  nameTh          String   @default("แผนกวิชาเทคโนโลยีคอมพิวเตอร์")
  nameEn          String?  @default("Department of Computer Technology")
  collegeName     String   @default("วิทยาลัยเทคนิค")
  faculty         String?  @default("ประเภทวิชาช่างอุตสาหกรรม")
  philosophy      String?  @db.Text // ปรัชญา
  vision          String?  @db.Text // วิสัยทัศน์
  mission         String?  @db.Text // พันธกิจ
  identity        String?  // เอกลักษณ์ (เช่น "ทักษะเด่น เน้นคุณธรรม")
  uniqueness      String?  // อัตลักษณ์ (เช่น "คอมพิวเตอร์ฮาร์ดแวร์และเน็ตเวิร์กเข้มข้น")
  colors          String?  @default("น้ำเงิน-ขาว") // สีประจำแผนก
  logoUrl         String?  // โลโก้แผนก
  coverUrl        String?  // ภาพหน้าปก
  headTeacherId   String?  // ครูหัวหน้าแผนก
  headTeacherName String?  // ชื่อหัวหน้าแผนก
  phone           String?  // เบอร์ติดต่อแผนก
  email           String?  // อีเมลแผนก
  facebook        String?  // เพจ / ช่องทางติดต่อ
  website         String?  // เว็บไซต์
  roomLocation    String?  // ที่ตั้งห้องพักครู / อาคารปฏิบัติการ เช่น "อาคาร 4 ชั้น 2"
  laboratories    Json?    // รายชื่อห้องปฏิบัติการและครุภัณฑ์หลัก [{ name, room, capacity, equipment }]
  qualityGoals    Json?    // เป้าหมายคุณภาพประจำปี [{ indicator, target, note }]
  academicYear    String?  // ปีการศึกษา เช่น "2569" หรือ null สำหรับโปรไฟล์หลัก
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

