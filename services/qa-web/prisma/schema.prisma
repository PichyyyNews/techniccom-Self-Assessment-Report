// Prisma Schema for TechSAR - Educational Quality Assurance System
// Database: PostgreSQL 16 (Proxmox CT 102)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LicenseStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  IN_RENEWAL
}

model LicenseCategoryConfig {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "ksp", "vocational", "other", "custom_..."
  title       String   // e.g. "ใบอนุญาตคุรุสภา / ผ่อนผัน (KSP)"
  description String?  // e.g. "มาตรฐานวิชาชีพครูสำหรับสถานศึกษา"
  icon        String   @default("GraduationCap") // "GraduationCap" | "Award" | "Shield" | "FileBadge" | "Briefcase" | "Sparkles"
  color       String   @default("teal") // "teal" | "emerald" | "blue" | "purple" | "amber" | "indigo" | "rose" | "slate"
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model LicenseTypeConfig {
  id                      String   @id @default(cuid())
  code                    String   @unique // e.g. "KSP_B_LICENSE", "TPQI_CERTIFICATE", "CUSTOM_..."
  title                   String   // e.g. "ใบอนุญาตประกอบวิชาชีพครูชั้นต้น (B-License)"
  description             String?  // e.g. "ใบอนุญาตประกอบวิชาชีพครูชั้นต้น (อายุ 5 ปี)"
  category                String   @default("ksp") // "ksp" | "vocational" | "other"
  categoryLabel           String?  // e.g. "ใบอนุญาตคุรุสภา / ผ่อนผัน (KSP)"
  defaultYears            Int      @default(5)     // อายุการใช้งานเริ่มต้น (ปี)
  issuer                  String?  // e.g. "สำนักงานเลขาธิการคุรุสภา", "สถาบันคุณวุฒิวิชาชีพ"
  color                   String   @default("teal") // "teal" | "purple" | "blue" | "amber" | "emerald" | "indigo" | "rose" | "slate"
  icon                    String   @default("GraduationCap") // "GraduationCap" | "Award" | "Shield" | "Clock" | "FileBadge" | "Briefcase" | "Sparkles"
  requiresProvisionalRound Boolean  @default(false) // true กรณีเป็นหนังสือผ่อนผัน (รอบ 1, 2, 3)
  requiresTitle           Boolean  @default(false) // true กรณีต้องระบุสาขา/ระดับ
  titleLabel              String?  // e.g. "ระบุสาขาวิชาชีพ / ระดับมาตรฐาน / สาขาวิศวกรรม"
  titlePlaceholder        String?  // e.g. "เช่น สาขาเทคโนโลยีสารสนเทศและการสื่อสาร ระดับ 4"
  presetChips             String[] @default([])    // รายการตัวเลือกแนะนำที่คลิกเพื่อใส่ข้อความ
  sortOrder               Int      @default(0)
  isActive                Boolean  @default(true)
  isSystem                Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([category])
  @@index([sortOrder])
}

model RoleDefinition {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "ROOT", "STAFF", "DEPT_HEAD", "TEACHER"
  title       String   // e.g. "ผู้ดูแลระบบสูงสุด (ROOT)", "บุคลากรทั่วไป (STAFF)"
  description String?
  color       String   @default("blue") // "rose" | "blue" | "emerald" | "purple" | "amber"
  permissions String[] // Allowed paths e.g. ["/dashboard", "/admin/users", "/profile"]
  isSystem    Boolean  @default(false) // true for ROOT (cannot be deleted)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "USER_LOGIN", "UPDATE_PROFILE", "UPDATE_EDUCATION", "UPDATE_EXPERIENCE", "UPDATE_SKILLS", "UPDATE_TEACHER_LICENSE", "UPLOAD_EVIDENCE", "CREATE_USER"
  title     String   // ข้อความกิจกรรม เช่น "อัปเดตข้อมูลส่วนตัว", "เพิ่มประวัติการศึกษา"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model TeacherLicense {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  licenseType       String        @default("KSP_B_LICENSE") // code from LicenseTypeConfig or enum string
  licenseNumber     String        // เลขที่ใบอนุญาต หรือ เลขที่หนังสือรับรอง
  title             String?       // ระบุสาขา/ระดับ (เช่น "สาขาวิศวกรรมคอมพิวเตอร์", "ระดับ 2", "สาขาเทคโนโลยีสารสนเทศ ระดับ 4")
  provisionalRound  Int?          // ครั้งที่ได้รับการผ่อนผัน (เฉพาะกรณีหนังสือผ่อนผัน: 1, 2, 3)
  
  nameTh            String?       // ชื่อ-นามสกุลภาษาไทยตามหน้าบัตร
  nameEn            String?       // ชื่อ-นามสกุลภาษาอังกฤษตามหน้าบัตร
  issuedDate        DateTime      // วันที่ออกบัตร / วันที่ได้รับหนังสือรับรอง
  expiredDate       DateTime      // วันที่หมดอายุ
  status            LicenseStatus @default(ACTIVE)

  // ไฟล์แนบหลักฐาน (สแกนบัตร / PDF จากคุรุสภา KSP Self-Service / TPQI / DSD)
  attachmentKey     String?       // S3/MinIO Key หรือ Application URL ของไฟล์เอกสาร
  attachmentName    String?       // ชื่อไฟล์เดิม

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([licenseType])
  @@index([expiredDate])
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String?
  name             String
  roleCode         String           @default("STAFF") // code reference
  roleDefinitionId String?
  roleDefinition   RoleDefinition?  @relation(fields: [roleDefinitionId], references: [id])
  position         String?          // ตำแหน่ง เช่น ครูผู้ช่วย, ครูชำนาญการ, เจ้าหน้าที่ธุรการ
  phone            String?          // เบอร์โทรศัพท์
  birthDate        DateTime?        // วันเดือนปีเกิด
  avatarUrl        String?          // URL รูปประจำตัว
  coverUrl         String?          // ภาพหน้าปกโปรไฟล์ (Cover photo)
  bio              String?          // คำแนะนำตัว / ปรัชญาการศึกษา
  education        Json?            // วุฒิการศึกษา [{ degree, major, institution, year }]
  workHistory      Json?            // ประวัติการทำงาน [{ role, organization, period }]
  licenses         Json?            // ใบอนุญาตประกอบวิชาชีพทั่วไป / อื่นๆ
  teacherLicenses  TeacherLicense[] // ข้อมูลใบอนุญาตประกอบวิชาชีพทางการศึกษาและคุณวุฒิวิชาชีพ (คุรุสภา / TPQI / DSD / กว.)
  skills           String[]         // ทักษะ / ความเชี่ยวชาญ
  isActive         Boolean          @default(true)
  evidenceFiles    EvidenceFile[]   // ไฟล์หลักฐานและร่องรอยผลงาน (แผนการสอน, วุฒิบัตร, ภาพอบรม, วิจัย, ชิ้นงานเด็ก ฯลฯ)
  activities       ActivityLog[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([email])
}

model EvidenceFile {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title         String   // ชื่อเอกสาร / หัวข้อหลักฐาน (เช่น "แผนการจัดการเรียนรู้วิชาเครือข่าย")
  description   String?  // รายละเอียดเพิ่มเติม (เช่น "สถานที่อบรม, หัวข้อบรรยาย")
  category      String   // "lesson_plan" | "training_cert" | "training_photo" | "speaker_activity" | "research" | "license" | "student_work" | "other"
  
  fileKey       String   // S3 MinIO Object Key
  fileUrl       String   // URL สำหรับเข้าถึงไฟล์
  fileName      String   // ชื่อไฟล์ต้นฉบับ
  fileType      String   // MIME Type เช่น "application/pdf", "image/jpeg"
  fileSize      Int      // ขนาดไฟล์ (Bytes)
  
  academicYear  String   @default("2568") // ปีการศึกษา เช่น "2568"
  semester      String   @default("1")    // ภาคเรียน เช่น "1", "2", "all"
  
  metadata      Json?    // { location, organization, eventDate, subjectCode, gradeLevel, externalVideoUrl }
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([academicYear, semester])
  @@index([createdAt])
}

