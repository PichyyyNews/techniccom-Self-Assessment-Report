// Prisma Schema for TechSAR - Educational Quality Assurance System
// Database: PostgreSQL 16 (Proxmox CT 102)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ROOT    // ผู้ดูแลระบบสูงสุด (Root Admin)
  STAFF   // บุคลากร (Personnel / Faculty / Staff)
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  role          Role      @default(STAFF)
  position      String?   // ตำแหน่ง เช่น ครูผู้ช่วย, ครูชำนาญการ, เจ้าหน้าที่ธุรการ
  phone         String?   // เบอร์โทรศัพท์
  birthDate     DateTime? // วันเดือนปีเกิด
  avatarUrl     String?   // URL รูปโปรไฟล์
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}
